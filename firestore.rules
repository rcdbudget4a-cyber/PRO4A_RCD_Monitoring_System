rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function approved() {
      return signedIn() && userProfile().data.status == "approved";
    }

    function isAdmin() {
      return approved() && userProfile().data.role == "admin";
    }

    function assignedUnit() {
      return userProfile().data.unit;
    }

    match /claims/{claimId} {
      allow read: if isAdmin()
        || (approved() && resource.data.province == assignedUnit());
      allow create: if isAdmin()
        || (approved() && request.resource.data.province == assignedUnit());
      allow update: if isAdmin()
        || (approved()
          && resource.data.province == assignedUnit()
          && request.resource.data.province == assignedUnit());
      allow delete: if isAdmin();
    }

    match /retirees/{retireeId} {
      allow read: if isAdmin()
        || (approved() && resource.data.unit == assignedUnit());
      allow create: if isAdmin()
        || (approved() && request.resource.data.unit == assignedUnit());
      allow update: if isAdmin()
        || (approved()
          && resource.data.unit == assignedUnit()
          && request.resource.data.unit == assignedUnit());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "unit_user"
        && request.resource.data.status == "pending"
        && request.resource.data.unit in [
          "RHQ", "Batangas PPO", "Cavite PPO", "Laguna PPO",
          "Quezon PPO", "Rizal PPO", "RMFB 4A"
        ];
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /activityHistory/{entryId} {
      allow read: if isAdmin()
        || (approved() && resource.data.unit == assignedUnit());
      allow create: if approved()
        && request.resource.data.actorUid == request.auth.uid
        && (isAdmin() || request.resource.data.unit == assignedUnit());
      allow update, delete: if false;
    }

    match /certifications/{certificationId} {
      allow read: if isAdmin()
        || (approved() && resource.data.unit == assignedUnit());
      allow create: if approved()
        && request.resource.data.certifiedUid == request.auth.uid
        && request.resource.data.unit == assignedUnit();
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if approved()
        && (resource.data.audience == "All Units"
          || resource.data.audience == assignedUnit()
          || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /archivedRecords/{archiveId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /systemErrors/{errorId} {
      allow read, update, delete: if isAdmin();
      allow create: if approved()
        && request.resource.data.actorUid == request.auth.uid;
    }

    match /reconciliationRuns/{runId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
